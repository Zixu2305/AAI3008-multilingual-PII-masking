# Copy this to .env (same folder as docker-compose.yml references: repo root)
# cp .env.example .env

# Host paths to mount into container
# Use absolute paths for fewer surprises.
RAW_DATA_DIR_HOST=/home/shoo/personal/dlDev/school/AAI3008-multilingual-PII-masking/data/raw
GOLD_DATA_DIR_HOST=/home/shoo/personal/dlDev/school/AAI3008-multilingual-PII-masking/data/gold
RUNS_DIR_HOST=/home/shoo/personal/dlDev/school/AAI3008-multilingual-PII-masking/data/runs

# HuggingFace cache on host (so you don’t re-download models/datasets)
HF_CACHE_HOST=/home/shoo/.cache/huggingface

# Optional: if you use AWS later
AWS_REGION=ap-southeast-1
# S3_BUCKET=your-bucket-name


# Pip cache on host (speeds up rebuilds)
PIP_CACHE_HOST=/home/shoo/.cache/pip
